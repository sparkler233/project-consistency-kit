{
  "description": "Project Consistency Kit lifecycle hooks.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/hooks/wrapup-reminder.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"& { $root = (git rev-parse --show-toplevel).Trim(); node (Join-Path $root '.agents/hooks/wrapup-reminder.mjs') }\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
